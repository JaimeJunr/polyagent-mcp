{
  "name": "polyagent-mcp",
  "version": "0.5.0",
  "description": "MCP server that lets any coding agent delegate to cheaper coding-agent CLIs (Codex, Claude Code, Grok, OpenCode): delegation, exploration, filtered command output, web lookup and cross-model second opinions, with context economy as the design goal.",
  "type": "module",
  "bin": {
    "polyagent-mcp": "dist/index.js",
    "polyagent-mcp-install-claude-md": "dist/installClaudeMd.js",
    "polyagent-mcp-install-skill": "dist/installSkill.js",
    "polyagent-mcp-doctor": "dist/doctorCli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "prepublishOnly": "npm run build",
    "bench": "npm run build && node bench/aux-bench.mjs",
    "bench:jev": "node bench/jev-bench.mjs",
    "install-claude-md": "node dist/installClaudeMd.js",
    "install-skill": "node dist/installSkill.js",
    "doctor": "node dist/doctorCli.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "claude-code",
    "codex",
    "coding-agent",
    "ai-agents",
    "delegation",
    "multi-agent",
    "llm",
    "context-engineering",
    "developer-tools"
  ],
  "author": "JaimeJunr",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JaimeJunr/polyagent-mcp.git"
  },
  "homepage": "https://github.com/JaimeJunr/polyagent-mcp#readme",
  "bugs": {
    "url": "https://github.com/JaimeJunr/polyagent-mcp/issues"
  }
}
